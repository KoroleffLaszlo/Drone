<?xml version="1.0"?>
<robot name="drone">

    <link name="body_link">
        <visual>
            <geometry>
                <box size="0.5 0.2 0.2"/>
            </geometry>
        </visual>

        <collision>
            <geometry>
                <box size="0.5 0.2 0.2"/>
            </geometry>
        </collision>
    </link>

    <link name="top_left_rotor">
        <visual>
            <geometry>
                <cylinder length="0.2" radius="0.2"/>
            </geometry>
            <!-- <material name="orange"/> -->
        </visual>

        <collision>
            <geometry>
                <cylinder length="0.2" radius="0.2"/>
            </geometry>
        </collision>
    </link>

    <link name="top_right_rotor">
        <visual>
            <geometry>
                <cylinder length="0.2" radius="0.2"/>
            </geometry>
            <!-- <material name="orange"/> -->
        </visual>

        <collision>
            <geometry>
                <cylinder length="0.2" radius="0.2"/>
            </geometry>
        </collision>
    </link>

    <link name="bot_left_rotor">
        <visual>
            <geometry>
                <cylinder length="0.2" radius="0.2"/>
            </geometry>
        </visual>

        <collision>
            <geometry>
                <cylinder length="0.2" radius="0.2"/>
            </geometry>
        </collision>
    </link>

    <link name="bot_right_rotor">
        <visual>
            <geometry>
                <cylinder length="0.2" radius="0.2"/>
            </geometry>
        </visual>

        <collision>
            <geometry>
                <cylinder length="0.2" radius="0.2"/>
            </geometry>
        </collision>
    </link>

    <joint name="body_to_tlr" type="fixed">
        <parent link="body_link"/>
        <child link="top_left_rotor"/>
        <origin xyz="0.25 0.25 0.06" rpy="0 0 0"/>
    </joint>

    <joint name="body_to_trr" type="fixed">
        <parent link="body_link"/>
        <child link="top_right_rotor"/>
        <origin xyz="0.25 -0.25 0.06" rpy="0 0 0"/>
    </joint>

    <joint name="body_to_blr" type="fixed">
        <parent link="body_link"/>
        <child link="bot_left_rotor"/>
        <origin xyz="-0.25 0.25 0.06" rpy="0 0 0"/>
    </joint>

    <joint name="body_to_brr" type="fixed">
        <parent link="body_link"/>
        <child link="bot_right_rotor"/>
        <origin xyz="-0.25 -0.25 0.06" rpy="0 0 0"/>
    </joint>
</robot>